---
// Landing story: the film is the page. Generated clips, scrubbed by scroll, in three chapters,
// full-screen behind the header, with the text on the calm side of the frame.
// Frames come from scripts/clips_to_frames.py (public/hero/{wide,tall}/<chapter>/NNNN.webp + story.json).
import { catById, url, asset, type Lang } from '../lib/i18n';
import { allRecipes } from '../lib/recipes';
import { icon } from '../lib/icons';

interface Chapter { id: string; count: number; stages: number[]; lum: { wide: string; tall: string } }
interface Size { w: number; h: number }
interface Props { lang: Lang; story: { wide: Size; tall: Size; chapters: Chapter[] } }
const { lang, story } = Astro.props;
const all = await allRecipes();
const n = (id: string) => all.filter((r) => r.category === id).length;
type T = { sr: string; en: string };
const TEXT: Record<string, { label: T; sub: T; heads: T[]; cats: string[] }> = {
  torta: {
    label: { sr: 'Torte i kolači', en: 'Cakes & sweets' },
    sub: { sr: 'Torte, kolači i sitni kolači iz Biljine sveske, korak po korak.', en: 'Cakes, bakes and small sweets from Bilja’s notebook, step by step.' },
    heads: [
      { sr: 'Sve počinje od testa.', en: 'It all starts with batter.' },
      { sr: 'Peče se polako.', en: 'Baked slowly.' },
      { sr: 'Kora po kora.', en: 'Layer by layer.' },
      { sr: 'Parče za vas.', en: 'A slice for you.' },
    ],
    cats: ['torte', 'kolaci', 'bez-pecenja', 'sitni-kolaci', 'kremovi-sladoledi'],
  },
  pecivo: {
    label: { sr: 'Peciva i pite', en: 'Breads & pies' },
    sub: { sr: 'Kiflice, pogače i pite koje mirišu na celu kuću.', en: 'Rolls, breads and pies that fill the whole house with their smell.' },
    heads: [
      { sr: 'Testo koje raste.', en: 'Dough that rises.' },
      { sr: 'Uvijeno rukom.', en: 'Rolled by hand.' },
      { sr: 'Rumeno u rerni.', en: 'Golden in the oven.' },
      { sr: 'Toplo iz rerne.', en: 'Warm from the oven.' },
    ],
    cats: ['peciva', 'pite'],
  },
  jelo: {
    label: { sr: 'Glavna jela', en: 'Main dishes' },
    sub: { sr: 'Kuvana jela, pečenja, salate i zimnica za svaki dan.', en: 'Stews, roasts, salads and preserves for every day.' },
    heads: [
      { sr: 'Od svežeg…', en: 'From fresh…' },
      { sr: '…preko vatre…', en: '…over the fire…' },
      { sr: '…do krčkanja.', en: '…to a slow simmer.' },
      { sr: 'Ručak je gotov.', en: 'Lunch is ready.' },
    ],
    cats: ['glavna-jela', 'salate-predjela', 'zimnica', 'napici'],
  },
};
const CLIP = 0.9;    // screens of scroll per clip
const HOLD = 0.9;    // screens the finished dish holds while its groups are up
const chapters = story.chapters.map((c) => ({ ...c, ...TEXT[c.id], scrub: (c.stages.length - 1) * CLIP }));
const total = chapters.reduce((s, c) => s + c.scrub + HOLD, 0);
const cue = lang === 'sr' ? 'Skrolujte' : 'Scroll';
const see = lang === 'sr' ? 'Pogledaj recepte' : 'See the recipes';
const skip = lang === 'sr' ? 'Preskoči' : 'Skip';
const data = { wide: story.wide, tall: story.tall, hold: HOLD, src: asset('hero/'), chapters: chapters.map((c) => ({ id: c.id, count: c.count, stages: c.stages, lum: c.lum, scrub: c.scrub, label: c.label[lang], sub: c.sub[lang], heads: c.heads.map((h) => h[lang]) })) };
const pad = (i: number) => String(i).padStart(4, '0');
---
<section class="story" data-story={JSON.stringify(data)} style={`--total:${total}`}>
  <div class="stick">
    <div class="media">
      <picture>
        <source media="(orientation: portrait)" srcset={asset(`hero/tall/${chapters[0].id}/0000.webp`)} />
        <img class="poster" src={asset(`hero/wide/${chapters[0].id}/0000.webp`)} alt="" fetchpriority="high" />
      </picture>
      <canvas aria-hidden="true"></canvas>
      <i class="shade light"></i><i class="shade night"></i>
    </div>

    <div class="side">
      <div class="txt">
        <p class="label" data-label>{chapters[0].label[lang]}</p>
        <h1 data-head>{chapters[0].heads[0][lang]}</h1>
        <p class="sub" data-sub>{chapters[0].sub[lang]}</p>
      </div>
      <div class="sheets">
        {chapters.map((c, i) => (
          <div class="sheet" data-sheet={i} aria-hidden={i === 0 ? 'false' : 'true'}>
            <a class="btn" href={url(lang, 'category', c.cats[0])}>{see}<Fragment set:html={icon('chev')} /></a>
            <div class="cats">
              {c.cats.map((id) => <a href={url(lang, 'category', id)}><b>{catById(id)[lang]}</b><span>{n(id)}</span></a>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <ol class="dots" aria-label="Chapters">
      {chapters.map((c, i) => <li><button type="button" data-dot={i} aria-label={c.label[lang]} aria-current={i === 0 ? 'true' : undefined}></button></li>)}
    </ol>
    <a class="skip" href="#posle">{skip}</a>
    <div class="cue" data-cue>{cue}<i></i></div>
  </div>

  <!-- no-motion / no-script version: the three finished dishes -->
  <div class="plain">
    {chapters.map((c) => (
      <article>
        <img src={asset(`hero/wide/${c.id}/${pad(c.count - 1)}.webp`)} alt={c.label[lang]} width={story.wide.w} height={story.wide.h} loading="lazy" />
        <p class="label">{c.label[lang]}</p>
        <h2>{c.heads[c.heads.length - 1][lang]}</h2>
        <div class="cats">
          {c.cats.map((id) => <a href={url(lang, 'category', id)}><b>{catById(id)[lang]}</b><span>{n(id)}</span></a>)}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .story { position: relative; --fg: var(--ink); --fg2: #4d3a2e; --acc: var(--main); }
  .label { font-size: 12.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--acc); margin: 0 0 10px; }
  .cats { display: flex; flex-wrap: wrap; gap: 8px; }
  .cats a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 6px 8px 6px 16px; border-radius: 999px; background: var(--paper); color: var(--ink); box-shadow: 0 1px 0 #3b2a2014, 0 8px 22px #3b2a2024; }
  .cats b { font-size: 15px; letter-spacing: -0.01em; }
  .cats span { min-width: 30px; height: 30px; padding: 0 8px; border-radius: 999px; display: grid; place-items: center; background: var(--soft); font-size: 13px; font-weight: 800; }

  /* ---------- the film (only when scripts run and motion is allowed) ---------- */
  .stick { display: none; }
  .story.live { margin-top: calc(-1 * var(--head-h)); height: calc(var(--total) * 100vh + 100vh); height: calc(var(--total) * 100svh + 100svh); background: #1c130e; }
  .story.live .plain { display: none; }
  .story.live .stick { display: block; position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: #1c130e; color: var(--fg); }
  .stick.dark { --fg: #fff; --fg2: #ffffffd9; --acc: var(--honey, #E0A53C); }
  .media, .poster, canvas, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster { object-fit: cover; object-position: 70% 50%; }
  canvas { opacity: 0; }
  .story.ready canvas { opacity: 1; }
  .story.ready .poster { visibility: hidden; }
  /* a soft wash behind the text, cream on light scenes and dark on oven scenes */
  .shade { transition: opacity .45s; pointer-events: none; }
  .shade.light { background: linear-gradient(180deg, #f6efe4f2 0%, #f6efe4b8 22%, #f6efe400 46%), linear-gradient(0deg, #f6efe4e6 0%, #f6efe400 calc(34% * var(--up, 0))); }
  .shade.night { background: linear-gradient(180deg, #120b07e6 0%, #120b07a6 24%, #120b0700 48%); opacity: 0; }
  .stick.dark .shade.light { opacity: 0; }
  .stick.dark .shade.night { opacity: 1; }

  .side { position: absolute; inset: 0; pointer-events: none; }
  .txt { position: absolute; left: 0; right: 0; top: 0; padding: calc(var(--head-h) + 18px) 56px 0 20px; }
  .txt h1 { font-size: clamp(36px, 11vw, 60px); line-height: .98; letter-spacing: -0.04em; max-width: 9.5ch; margin: 0; color: var(--fg); text-wrap: balance; }
  .sub { margin: 12px 0 0; max-width: 26ch; font-size: 15.5px; line-height: 1.35; font-weight: 600; color: var(--fg2); }
  .txt h1, .txt .label, .sub { transition: opacity .28s, transform .28s, color .45s; }
  .txt.swap h1, .txt.swap .label, .txt.swap .sub { opacity: 0; transform: translateY(8px); }
  @media (max-height: 640px) { .sub { display: none; } }

  .sheet { position: absolute; left: 16px; right: 16px; bottom: calc(var(--nav-h) + env(safe-area-inset-bottom) + 14px); display: flex; flex-direction: column-reverse; gap: 10px; opacity: var(--a, 0); transform: translateY(calc((1 - var(--a, 0)) * 28px)); visibility: hidden; }
  .sheet.on { visibility: visible; pointer-events: auto; }
  .sheet .btn { width: 100%; box-shadow: 0 10px 26px #3b2a2040; }

  .dots { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .dots button { width: 28px; height: 28px; display: grid; place-items: center; }
  .dots button::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--fg); opacity: .35; transition: .2s; }
  .dots button[aria-current='true']::after { background: var(--acc); opacity: 1; transform: scale(1.5); }
  .skip { position: absolute; right: 8px; top: calc(var(--head-h) + 6px); font-size: 13px; font-weight: 800; color: var(--fg2); padding: 10px 8px; min-height: 40px; transition: color .45s; }
  .cue { position: absolute; left: 0; right: 0; bottom: calc(var(--nav-h) + env(safe-area-inset-bottom) + 16px); display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--fg); pointer-events: none; transition: opacity .3s; text-shadow: 0 0 12px #f6efe4; }
  .cue i { width: 2px; height: 22px; background: currentColor; border-radius: 2px; animation: cue 1.4s infinite ease-in-out; transform-origin: top; }
  @keyframes cue { 0%, 100% { transform: scaleY(.3); opacity: .4; } 50% { transform: scaleY(1); opacity: 1; } }

  /* ---------- wide screens: text on the left of the film, food on the right ---------- */
  @media (min-width: 900px) and (orientation: landscape) {
    .shade.light { background: linear-gradient(90deg, #f6efe4f0 0%, #f6efe4c4 26%, #f6efe400 58%); }
    .shade.night { background: linear-gradient(90deg, #120b07eb 0%, #120b07b0 28%, #120b0700 60%); }
    .side { display: flex; flex-direction: column; justify-content: center; gap: 30px; inset: var(--head-h) auto 0 max(40px, calc((100vw - 1320px) / 2)); width: min(40vw, 560px); }
    .txt { position: static; padding: 0; }
    .txt h1 { font-size: clamp(54px, 6.4vw, 104px); max-width: 9ch; }
    .label { font-size: 14px; margin-bottom: 16px; }
    .sub { font-size: 19px; max-width: 30ch; margin-top: 20px; }
    .sheets { position: relative; min-height: 170px; }
    .sheet { left: 0; right: 0; top: 0; bottom: auto; flex-direction: column; gap: 16px; opacity: var(--cur, 0); transform: none; transition: opacity .3s; }
    .sheet .btn { width: auto; align-self: flex-start; }
    .sheet .cats { opacity: var(--a, 0); transform: translateY(calc((1 - var(--a, 0)) * 16px)); }
    .cue { left: max(40px, calc((100vw - 1320px) / 2)); right: auto; bottom: 30px; align-items: flex-start; text-shadow: none; }
    .skip { top: auto; right: 54px; bottom: 22px; }
    .dots { right: 18px; }
  }

  /* ---------- no motion / no script ---------- */
  .plain article { padding: 22px 16px 8px; max-width: 720px; margin: 0 auto; }
  .plain img { width: 100%; height: auto; border-radius: 22px; margin-bottom: 16px; }
  .plain h2 { margin-bottom: 14px; }
  .plain .cats a { box-shadow: inset 0 0 0 1.5px var(--line); }
</style>
<!-- while the film is on screen the top bar floats over it -->
<style is:global>
  .head { transition: background-color .3s, border-color .3s, color .45s; }
  .head .logo .lt { display: none; }
  body.film .head { background: transparent; border-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  body.film-dark .head { color: #fff; }
  body.film-dark .head .lang { border-color: #fff; }
  body.film-dark .head .logo .dk { display: none; }
  body.film-dark .head .logo .lt { display: block; }
  body.film-dark .head nav a[aria-current='page'], body.film-dark .head nav a:hover { background: #ffffff26; }
</style>

<script>
  interface Ch { id: string; count: number; stages: number[]; lum: { wide: string; tall: string }; scrub: number; label: string; sub: string; heads: string[] }
  type Fmt = 'wide' | 'tall';
  const root = document.querySelector<HTMLElement>('[data-story]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    root.classList.add('live');
    const D = JSON.parse(root.dataset.story!) as { wide: { w: number; h: number }; tall: { w: number; h: number }; hold: number; src: string; chapters: Ch[] };
    const stick = root.querySelector<HTMLElement>('.stick')!;
    const cv = root.querySelector('canvas')!;
    const ctx = cv.getContext('2d')!;
    const txt = root.querySelector<HTMLElement>('.txt')!;
    const head = root.querySelector<HTMLElement>('[data-head]')!;
    const label = root.querySelector<HTMLElement>('[data-label]')!;
    const sub = root.querySelector<HTMLElement>('[data-sub]')!;
    const cue = root.querySelector<HTMLElement>('[data-cue]')!;
    const sheets = [...root.querySelectorAll<HTMLElement>('[data-sheet]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const lightShade = root.querySelector<HTMLElement>('.shade.light')!;
    type Img = ImageBitmap | HTMLImageElement;
    const starts: number[] = [];
    let acc = 0;
    for (const c of D.chapters) { starts.push(acc); acc += c.scrub + D.hold; }
    const total = acc;

    // ---------- which film: wide for landscape screens, tall for portrait ----------
    const pick = (): Fmt => (innerWidth >= innerHeight ? 'wide' : 'tall');
    let fmt: Fmt = pick(), gen = 0;
    let frames: (Img | null)[][] = [];

    // ---------- loading: first chapter coarse, then everything in scroll order ----------
    const load = async (c: number, i: number, g = gen) => {
      if (g !== gen || frames[c][i]) return;
      try {
        const blob = await (await fetch(`${D.src}${fmt}/${D.chapters[c].id}/${String(i).padStart(4, '0')}.webp`)).blob();
        const im = 'createImageBitmap' in window ? await createImageBitmap(blob) : await new Promise<HTMLImageElement>((ok) => { const el = new Image(); el.onload = () => ok(el); el.src = URL.createObjectURL(blob); });
        if (g !== gen) return;
        frames[c][i] = im;
        if (c === 0 && i === 0) root.classList.add('ready');
        schedule();
      } catch {}
    };
    const start = () => {
      const g = ++gen;
      frames = D.chapters.map((c) => new Array(c.count).fill(null));
      const queue: [number, number][] = [];
      const pass = (c: number, step: number) => { for (let i = 0; i < D.chapters[c].count; i += step) queue.push([c, i]); };
      pass(0, 8); D.chapters.forEach((_, c) => c && pass(c, 16)); D.chapters.forEach((_, c) => pass(c, 4)); D.chapters.forEach((_, c) => pass(c, 2)); D.chapters.forEach((_, c) => pass(c, 1));
      (async () => { await load(0, 0, g); let k = 0; const run = async () => { while (k < queue.length && g === gen) { const [c, i] = queue[k++]; await load(c, i, g); } }; await Promise.all([run(), run(), run(), run()]); })();
    };

    // ---------- drawing: the frame always covers the whole screen ----------
    let want = { c: 0, f: 0, next: -1, mix: 0 }, drawn = '', raf = 0;
    const nearest = (c: number, i: number): [Img, number] | null => {
      const a = frames[c];
      for (let d = 0; d < a.length; d++) { if (a[i - d]) return [a[i - d]!, i - d]; if (a[i + d]) return [a[i + d]!, i + d]; }
      return null;
    };
    const put = (im: Img, alpha: number) => {
      const { w, h } = D[fmt], cw = cv.width, ch = cv.height;
      const s = Math.max(cw / w, ch / h), dw = w * s, dh = h * s;
      // when the sides are cut, keep the food: it sits on the right of the wide film and low in the tall one
      const ax = fmt === 'wide' ? 0.72 : 0.5, ay = fmt === 'wide' ? 0.5 : 0.62;
      ctx.globalAlpha = alpha;
      ctx.drawImage(im as any, (cw - dw) * ax, (ch - dh) * ay, dw, dh);
      ctx.globalAlpha = 1;
    };
    const draw = () => {
      raf = 0;
      const a = nearest(want.c, Math.round(want.f));
      if (!a) return;
      const b = want.next >= 0 && want.mix > 0 ? nearest(want.next, 0) : null;
      const key = `${fmt}:${want.c}:${a[1]}:${b ? want.mix.toFixed(2) : ''}:${cv.width}x${cv.height}`;
      if (key === drawn) return;
      put(a[0], 1);
      if (b) put(b[0], want.mix);
      drawn = key;
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(draw); };
    const size = () => {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      cv.width = Math.round(cv.clientWidth * dpr); cv.height = Math.round(cv.clientHeight * dpr);
      if (pick() !== fmt) { fmt = pick(); start(); }
      drawn = ''; schedule();
    };

    // ---------- scroll -> state ----------
    const clamp = (v: number, a = 0, b = 1) => Math.max(a, Math.min(b, v));
    const unit = () => (root.offsetHeight - stick.clientHeight) / total;   // one "screen" of story in pixels
    // ?story=2.4 shows the story as it looks that many screens in (for checking it)
    const forced = parseFloat(new URLSearchParams(location.search).get('story') || '');
    let shown = '0:0', dark = false;
    const setText = (c: number, s: number) => {
      const k = `${c}:${s}`; if (k === shown) return; shown = k;
      txt.classList.add('swap');
      setTimeout(() => { head.textContent = D.chapters[c].heads[s]; label.textContent = D.chapters[c].label; sub.textContent = D.chapters[c].sub; txt.classList.remove('swap'); }, 180);
    };
    const onScroll = () => {
      const raw = -root.getBoundingClientRect().top / unit();
      const t = isNaN(forced) ? clamp(raw, 0, total) : clamp(forced, 0, total);
      let c = D.chapters.length - 1;
      while (c > 0 && t < starts[c]) c--;
      const ch = D.chapters[c], local = t - starts[c];
      let f: number, hold = -1;
      if (local < ch.scrub) f = (local / ch.scrub) * (ch.count - 1);
      else { f = ch.count - 1; hold = clamp((local - ch.scrub) / D.hold); }
      const last = c === D.chapters.length - 1;
      const mix = hold > 0.8 && !last ? (hold - 0.8) / 0.2 : 0;
      want = { c, f, next: last ? -1 : c + 1, mix };
      load(c, Math.round(f));                                  // make sure the frame on screen is fetched first
      if (mix > 0) load(c + 1, 0);
      const cur = mix > 0.5 ? c + 1 : c;
      // headline = the nearest stage
      let s = 0; ch.stages.forEach((st, i) => { if (Math.abs(st - f) < Math.abs(ch.stages[s] - f)) s = i; });
      if (cur !== c) setText(cur, 0); else setText(c, s);
      // white text while the text side of the frame is dark (with a little hysteresis so it doesn't flicker)
      const lum = cur !== c ? +D.chapters[cur].lum[fmt][0] : +ch.lum[fmt][Math.round(f)];
      if (dark ? lum >= 4 : lum <= 2) dark = !dark;
      const onFilm = isNaN(forced) ? raw < total + 0.92 : true;   // the film still fills the top of the screen
      stick.classList.toggle('dark', dark);
      document.body.classList.toggle('film', onFilm);
      document.body.classList.toggle('film-dark', onFilm && dark);
      // the groups of the finished dish
      const a = hold >= 0 ? clamp(hold / 0.16) * (last ? 1 : 1 - clamp((hold - 0.7) / 0.12)) : 0;
      lightShade.style.setProperty('--up', String(a));
      sheets.forEach((el, i) => {
        const mine = i === cur, on = mine && (a > 0.5 || matchMedia('(min-width: 900px) and (orientation: landscape)').matches);
        el.style.setProperty('--cur', mine ? '1' : '0');
        el.style.setProperty('--a', i === c ? String(a) : '0');
        el.classList.toggle('on', on);
        el.setAttribute('aria-hidden', on ? 'false' : 'true');
        el.querySelectorAll('a').forEach((x) => (x.tabIndex = on ? 0 : -1));
      });
      cue.style.opacity = t < 0.15 ? '1' : '0';
      dots.forEach((d, i) => (i === cur ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      schedule();
    };
    const go = (t: number) => scrollTo({ top: root.offsetTop + t * unit() + 2, behavior: 'smooth' });
    dots.forEach((d, i) => d.addEventListener('click', () => go(starts[i])));
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', () => { size(); onScroll(); });
    start(); size(); onScroll();
  }
</script>
